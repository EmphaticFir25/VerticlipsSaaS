# Copy to .env and fill in. Never commit .env.

# ---- Required ----
# Your domain, without https://. Caddy gets the HTTPS certificate for it automatically.
DOMAIN=app.verticlip.site
# Public HTTPS address customers use. OAuth redirects are built from it.
PUBLIC_BASE=https://app.verticlip.site
# Long random string. Encrypts stored YouTube/TikTok tokens; changing it disconnects every account.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Claude scores moments and writes titles, hooks and hashtags.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_EFFORT=low
# Whisper API for word-level transcripts.
OPENAI_API_KEY=
# Optional: any OpenAI-compatible transcription endpoint (e.g. Groq) instead of OpenAI.
# TRANSCRIBE_URL=https://api.openai.com/v1/audio/transcriptions
# TRANSCRIBE_MODEL=whisper-1
# TRANSCRIBE_API_KEY=
# Cheaper option to test: Groq (~$0.04/hour). Confirm it returns word timestamps before switching.
# TRANSCRIBE_URL=https://api.groq.com/openai/v1/audio/transcriptions
# TRANSCRIBE_MODEL=whisper-large-v3-turbo

# ---- Who runs this (shown on the Terms, Privacy and Copyright pages; REQUIRED on an https PUBLIC_BASE) ----
LEGAL_NAME=
LEGAL_ADDRESS=
CONTACT_EMAIL=
# PRIVACY_EMAIL=          # defaults to CONTACT_EMAIL
# ABUSE_EMAIL=            # copyright and abuse reports; also your designated DMCA agent address
# SECURITY_EMAIL=         # published in /.well-known/security.txt
# JURISDICTION=the Commonwealth of Massachusetts, United States
# MIN_AGE=16

# ---- Email (required in production: sign-up confirmation and password reset) ----
# Any SMTP provider works (Resend, Postmark, Amazon SES, Mailgun, Gmail with an app password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Verticlip <no-reply@yourdomain.com>
# New accounts must confirm their email before making clips. On automatically once SMTP_HOST is set.
# REQUIRE_EMAIL_VERIFICATION=true
# Set to true only if the site is behind Cloudflare. Otherwise the CF-Connecting-IP header can be forged.
# TRUST_CLOUDFLARE=false

# ---- Publishing (optional) ----
# Google Cloud OAuth client (type: Web application). Redirect URI: <PUBLIC_BASE>/auth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# private | unlisted | public
YOUTUBE_PRIVACY=private
# TikTok Login Kit (Web). Redirect URI: <PUBLIC_BASE>/auth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---- Billing (optional; paid plans show "Coming soon" until set) ----
STRIPE_SECRET_KEY=
# Webhook endpoint: <PUBLIC_BASE>/api/billing/webhook
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=

# ---- Data retention (days; 0 turns a rule off). Keep these in step with the Privacy Policy, which prints them. ----
# SOURCE_RETENTION_DAYS=14
# PROJECT_RETENTION_DAYS=90
# UNVERIFIED_ACCOUNT_DAYS=7

# ---- Abuse protection ----
# Cloudflare Turnstile (free): https://dash.cloudflare.com -> Turnstile. Both keys set = bot check on sign-up and reports.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# SIGNUPS_PER_HOUR=10
# API_WRITES_PER_MINUTE=120
# HIBP_CHECK=true
# BLOCK_DISPOSABLE_EMAIL=true

# ---- Monitoring (optional) ----
# Error tracking. Personal data is stripped before anything is sent.
SENTRY_DSN=

# ---- Backups (see README) ----
# Long random passphrase. Store a copy OUTSIDE this server: without it the backups can't be read.
BACKUP_PASSPHRASE=
# BACKUP_KEEP_DAYS=14
# BACKUP_INCLUDE_MEDIA=false

# ---- Billing: tax ----
# Turn on Stripe Tax (set it up in the Stripe dashboard first) so checkout collects the address and adds VAT / sales tax.
# STRIPE_TAX=true

# ---- Plans & limits (optional) ----
# FREE_MINUTES=30
# PRO_MINUTES=600
# STUDIO_MINUTES=1200
# PRO_PRICE_USD=19
# STUDIO_PRICE_USD=49
# MAX_SOURCE_MINUTES=180
# MAX_UPLOAD_MB=2048
# WORKERS=2
# ALLOW_SIGNUPS=true
